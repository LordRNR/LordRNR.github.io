---
interface Props {
  human: string[];
  assisted: string[];
}
const { human, assisted } = Astro.props;
---

<div class="contrib" data-stagger>
  <section class="col h" aria-labelledby="c-human">
    <h3 id="c-human" class="mono">Human decisions</h3>
    <ul>{human.map((t) => <li>{t}</li>)}</ul>
  </section>
  <section class="col a" aria-labelledby="c-ai">
    <h3 id="c-ai" class="mono">AI-assisted work</h3>
    <ul>{assisted.map((t) => <li>{t}</li>)}</ul>
  </section>
  <p class="resp">
    I am responsible for what is published here: figures are checked against the project's own reports, and anything not yet validated is labelled Pending.
  </p>
</div>

<style>
  .contrib {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .col {
    padding: clamp(20px, 2.2vw, 30px);
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .col.h {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  h3 {
    margin-bottom: 14px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }
  ul {
    display: grid;
    gap: 10px;
  }
  li {
    position: relative;
    padding-left: 18px;
    color: var(--ink);
    line-height: 1.5;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .a li::before {
    background: var(--muted);
  }
  .resp {
    grid-column: 1 / -1;
    padding: 4px 4px 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 52em;
  }
  @media (max-width: 800px) {
    .contrib {
      grid-template-columns: 1fr;
    }
  }
</style>
