---
import Media from '../components/Media.astro';
import Tag from '../components/Tag.astro';
import { copy } from '../data/copy';
import { contact, heroLines, parseEmphasis, site } from '../lib/site';
import { fmtDate, formatMetric, getFeatured } from '../lib/projects';
import { getMedia, kindLabel } from '../lib/media';

const featured = await getFeatured();
const star = featured.find((p) => p.data.media.hero);
const heroId = star?.data.media.hero;
const heroEntry = heroId ? getMedia(heroId).entry : null;

// Secondary image: the first gallery item that has a chapter with a tag, so the stamp comes from data.
const cardId = star?.data.media.gallery[1] ?? star?.data.media.gallery[0];
const cardTag = star?.data.chapters.find((c) => c.media === cardId)?.tags[0];

// Hero figures: metrics flagged `hero`, in project order, max 4. Every one has a source and a date.
const stats = featured.flatMap((p) => p.data.metrics.filter((m) => m.hero).map((m) => ({ m, project: p.data.name }))).slice(0, 4);

// Headline words: index them once so the entrance can stagger; `*word*` becomes the italic accent.
let n = 0;
const lines = heroLines().map((line) =>
  parseEmphasis(line).flatMap((seg) =>
    seg.text
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => ({ w, em: seg.em, i: n++ })),
  ),
);
const plainHeadline = heroLines().join(' ').replace(/\*/g, '');
const { start, expectedEnd } = site.education;
const identity = start && expectedEnd ? `${site.role} · ${start}–${expectedEnd}` : site.role;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="wrap">
    <p class="eyebrow mono" data-in style="--d:0">
      <span>{site.name}</span><span class="sep" aria-hidden="true">·</span><span>{identity}</span>
      {site.availability && <span class="live"><i class="dot" aria-hidden="true"></i>{site.availability}</span>}
    </p>

    <h1 id="hero-title" class="hl" aria-label={plainHeadline}>
      {
        lines.map((words) => (
          <span class="ln" aria-hidden="true">
            {words.map((word) => (
              <>
                <span class="w" style={`--i:${word.i}`}>
                  <span>{word.em ? <em>{word.w}</em> : word.w}</span>
                </span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </h1>

    <div class="row">
      <p class="sub" data-in style="--d:3">{copy.hero.sub}</p>
      <div class="cta" data-in style="--d:4">
        <a class="btn primary" data-mag href="/projects/">
          View projects
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="btn ghost" data-mag href={contact.github} rel="noopener">
          GitHub
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
        </a>
        {site.resume.pdf && <a class="btn ghost" data-mag href={site.resume.pdf} download>Download CV</a>}
      </div>
    </div>

    {
      heroId && star && heroEntry && (
        <div class="stage" data-tilt>
          <div class="stage-in" data-tilt-inner>
            <div class="stage-main">
              <div class="bg" data-parallax="0.07">
                <Media id={heroId} priority sizes="(min-width: 1240px) 1240px, 100vw" />
              </div>
              <span class="chip-top mono"><i class="dot" aria-hidden="true"></i>{kindLabel[heroEntry.kind]} · {star.data.name}</span>
            </div>
            {stats.length > 0 && (
              <ul class="stats" aria-label="Verified figures" data-count-delay>
                {stats.map(({ m, project }) => (
                  <li class="stat" title={`${m.source} (as of ${fmtDate(m.asOf)})`}>
                    <b>
                      {m.display ? m.display : (
                        <>
                          {m.prefix}
                          <span data-count={m.value} data-dec={m.decimals}>
                            {m.value.toLocaleString('en-US', { minimumFractionDigits: m.decimals, maximumFractionDigits: m.decimals })}
                          </span>
                          {m.suffix}
                        </>
                      )}
                    </b>
                    <span>{m.short ?? `${m.label} · ${project}`}</span>
                  </li>
                ))}
              </ul>
            )}
            {cardId && (
              <figure class="stage-card">
                <Media id={cardId} sizes="(min-width: 1000px) 360px, 0px" />
                {cardTag && <span class="card-tag"><Tag state={cardTag.state} label={cardTag.label} small /></span>}
              </figure>
            )}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: calc(var(--nav-h) + clamp(24px, 6vh, 72px)) 0 clamp(72px, 10vh, 120px);
    overflow: clip;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -10% -10% auto auto;
    width: 80vw;
    height: 80vw;
    max-width: 1100px;
    max-height: 1100px;
    z-index: -2;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%);
    opacity: 0.7;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(520px circle at var(--mx, 70%) var(--my, 22%), color-mix(in srgb, var(--accent-2) 16%, transparent), transparent 60%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 96px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 96px 100%;
    -webkit-mask-image: radial-gradient(ellipse at 60% 20%, #000 0, transparent 72%);
    mask-image: radial-gradient(ellipse at 60% 20%, #000 0, transparent 72%);
    opacity: 0.55;
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: center;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .eyebrow span:first-child {
    color: var(--ink);
  }
  @media (max-width: 520px) {
    .sep {
      display: none;
    }
    .eyebrow {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
  .live {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--glass);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    display: inline-block;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    animation: ping 2.4s infinite;
  }
  @keyframes ping {
    70% {
      box-shadow: 0 0 0 9px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .hl {
    margin-top: clamp(20px, 3.5vh, 36px);
    font-weight: 650;
    font-size: clamp(40px, 6.9vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .ln {
    display: block;
  }
  .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0 0.04em 0.14em;
    margin: 0 -0.04em -0.14em;
  }
  .w > span {
    display: inline-block;
  }
  :global(.js) .w > span {
    translate: 0 112%;
    transition: translate 1.1s var(--ease) calc(0.25s + var(--i) * 0.085s);
  }
  :global(.js.loaded) .w > span {
    translate: 0 0;
  }
  .hl em {
    font: italic 500 1.02em var(--font-serif);
    letter-spacing: -0.03em;
    padding-right: 0.02em;
    background: linear-gradient(100deg, var(--accent) 10%, var(--accent-2) 45%, var(--ink) 55%, var(--accent) 90%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: sheen 9s ease-in-out infinite alternate;
  }
  @keyframes sheen {
    to {
      background-position: 100% 0;
    }
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
    margin-top: clamp(20px, 3vh, 36px);
  }
  .sub {
    max-width: 36em;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.5;
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 14px 24px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 500;
    font-size: 15px;
    transition:
      background 0.35s var(--ease),
      border-color 0.35s,
      color 0.35s,
      translate 0.3s var(--ease);
  }
  .btn svg {
    transition: translate 0.35s var(--ease);
  }
  .btn:hover svg {
    translate: 3px 0;
  }
  .primary {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .ghost:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    border-color: var(--ink);
  }
  :global(.js) [data-in] {
    opacity: 0;
    translate: 0 20px;
    transition:
      opacity 0.9s var(--ease) calc(0.6s + var(--d, 0) * 0.1s),
      translate 0.9s var(--ease) calc(0.6s + var(--d, 0) * 0.1s);
  }
  :global(.js.loaded) [data-in] {
    opacity: 1;
    translate: 0 0;
  }

  .stage {
    position: relative;
    margin-top: clamp(28px, 5vh, 56px);
    perspective: 1400px;
  }
  .stage-in {
    position: relative;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.5s var(--ease);
    transform-style: preserve-3d;
  }
  .stage-main {
    position: relative;
    aspect-ratio: 21 / 9;
    border-radius: 30px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  :global(.js) .stage-main {
    clip-path: inset(16% 12% 16% 12% round 40px);
    transition: clip-path 1.25s var(--ease-io) 0.25s;
  }
  :global(.js.loaded) .stage-main {
    clip-path: inset(0 round 30px);
  }
  .bg {
    position: absolute;
    inset: -9% 0;
    height: 118%;
    will-change: translate;
  }
  .bg :global(picture),
  .bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stage-main::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 9 13 / 0.25) 0, transparent 30%, transparent 55%, rgb(7 9 13 / 0.78) 100%);
  }
  .chip-top {
    position: absolute;
    z-index: 3;
    left: 18px;
    top: 18px;
    display: inline-flex;
    gap: 10px;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(16 22 30 / 0.78);
    border: 1px solid rgb(243 238 228 / 0.14);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f3eee4;
  }
  .stats {
    position: absolute;
    z-index: 3;
    left: 18px;
    bottom: 18px;
    right: calc(min(30%, 360px) + clamp(12px, 3vw, 40px) + 20px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-radius: 20px;
    background: rgb(16 22 30 / 0.8);
    border: 1px solid rgb(243 238 228 / 0.14);
    color: #f3eee4;
  }
  .stat {
    padding: 16px 18px;
    border-left: 1px solid rgb(243 238 228 / 0.14);
  }
  .stat:first-child {
    border-left: 0;
  }
  .stat b {
    display: block;
    font: 600 clamp(22px, 2.6vw, 38px) / 1 var(--font-sans);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .stat > span {
    display: block;
    margin-top: 8px;
    font: 500 10.5px / 1.35 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #aeb8c3;
  }
  .stage-card {
    position: absolute;
    z-index: 4;
    right: clamp(12px, 3vw, 40px);
    bottom: -52px;
    width: min(30%, 360px);
    aspect-ratio: 16 / 10;
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 24%, transparent);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.85);
    transform: translateZ(60px);
    background: var(--surface);
  }
  .stage-card :global(picture),
  .stage-card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-tag {
    position: absolute;
    left: 10px;
    top: 10px;
    background: rgb(7 9 13 / 0.8);
    border-radius: 999px;
  }
  :global(.js) .stage-card,
  :global(.js) .stats {
    opacity: 0;
    translate: 0 28px;
    transition:
      opacity 1s var(--ease) 1.4s,
      translate 1s var(--ease) 1.4s;
  }
  :global(.js.loaded) .stage-card,
  :global(.js.loaded) .stats {
    opacity: 1;
    translate: 0 0;
  }
  @media (max-width: 1000px) {
    .row {
      grid-template-columns: 1fr;
    }
    .cta {
      justify-content: flex-start;
    }
    .stage-main {
      aspect-ratio: 4 / 3;
    }
    .stage-card {
      display: none;
    }
    .stats {
      position: static;
      margin-top: 12px;
      grid-template-columns: repeat(2, 1fr);
      background: var(--surface);
      color: var(--ink);
      border-color: var(--line);
    }
    .stat {
      border-left-color: var(--line);
    }
    .stat:nth-child(odd) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .stat > span {
      color: var(--muted);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .w > span {
      translate: none;
    }
    :global(.js) .stage-main {
      clip-path: none;
    }
    :global(.js) [data-in],
    :global(.js) .stage-card,
    :global(.js) .stats {
      opacity: 1;
      translate: none;
    }
    .hl em {
      animation: none;
    }
    .dot {
      animation: none;
    }
  }
</style>
