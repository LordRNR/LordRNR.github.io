---
// Wrapper that styles rendered Markdown (project bodies). Kept deliberately small.
---

<div class="prose"><slot /></div>

<style>
  .prose {
    max-width: 44em;
    color: var(--muted);
    font-size: clamp(17px, 1.25vw, 19px);
    line-height: 1.7;
  }
  .prose :global(p + p),
  .prose :global(p + h2),
  .prose :global(ul + p) {
    margin-top: 1.1em;
  }
  .prose :global(h2) {
    margin-top: 1.8em;
    margin-bottom: 0.5em;
    color: var(--ink);
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 600;
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
  }
  .prose :global(a:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }
  .prose :global(ul) {
    margin: 1em 0 0;
    padding-left: 1.2em;
    list-style: disc;
  }
</style>
