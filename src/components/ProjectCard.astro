---
import Media from './Media.astro';
import Tag from './Tag.astro';
import { categoryLabel, formatPeriod, statusMeta, type Project } from '../lib/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const d = project.data;
const href = d.caseStudy.enabled ? `/projects/${project.id}/` : null;
const initial = d.name.charAt(0).toUpperCase();
---

<article class="card" data-card data-spot data-category={d.category} data-tech={d.tech.join('|')}>
  <div class="visual" aria-hidden={d.media.hero ? undefined : 'true'}>
    {
      d.media.hero ? (
        <Media id={d.media.hero} sizes="(min-width: 900px) 560px, 100vw" />
      ) : (
        <div class="emblem">
          <span class="ini">{initial}</span>
          <span class="cat mono">{categoryLabel[d.category]}</span>
        </div>
      )
    }
  </div>
  <div class="text">
    <div class="meta">
      <Tag state={d.status} label={d.statusNote ? `${statusMeta[d.status].label} · ${d.statusNote}` : undefined} small />
      <span class="when mono">{formatPeriod(project)}</span>
    </div>
    <h2>
      {href ? <a href={href} class="stretch">{d.name}</a> : d.name}
    </h2>
    <p>{d.tagline}</p>
    <ul class="tech" aria-label="Technologies">
      {d.tech.slice(0, 6).map((t) => <li class="mono">{t}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition:
      transform 0.45s var(--ease),
      border-color 0.4s;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
    background: radial-gradient(420px circle at var(--cx, 50%) var(--cy, 0%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 65%);
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-6px);
    border-color: var(--line-strong);
  }
  .card:hover::before {
    opacity: 1;
  }
  .card[hidden] {
    display: none;
  }
  .visual {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }
  .visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.9s var(--ease);
  }
  .card:hover .visual :global(img) {
    scale: 1.04;
  }
  .emblem {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 32px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 32px 100%,
      radial-gradient(60% 80% at 70% 20%, color-mix(in srgb, var(--accent) 18%, transparent), transparent);
  }
  .ini {
    font: italic 500 clamp(72px, 9vw, 120px) / 1 var(--font-serif);
    color: var(--ink);
  }
  .cat {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 2vw, 28px);
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .when {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  h2 {
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 620;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  p {
    color: var(--muted);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
  }
  .tech li {
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
</style>
