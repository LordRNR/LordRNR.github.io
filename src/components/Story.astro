---
import Media from './Media.astro';
import Tag from './Tag.astro';
import { getMedia, kindLabel } from '../lib/media';
import type { Project } from '../lib/projects';

/**
 * Scrollytelling: a sticky stage with one scene per chapter. Chapters, images, tags and figures all come
 * from the project's data; swapping a capture means editing media.json, not this component.
 * Desktop: sticky stage + text. Mobile: each chapter shows its own image (stage hidden).
 */
interface Props {
  chapters: Project['data']['chapters'];
}
const { chapters } = Astro.props;
const info = (id: string) => getMedia(id).entry;
const captionOf = (id: string) => `${kindLabel[info(id).kind]} · ${info(id).caption}`;
---

{
  chapters.length > 0 && (
    <div class="story" data-story>
      <div class="stage" aria-hidden="true">
        {chapters.map((c, i) => (
          <div class:list={['shot', { on: i === 0 }]} data-shot>
            <Media id={c.media} decorative sizes="(min-width: 900px) 800px, 0px" />
          </div>
        ))}
        <div class="dots">
          {chapters.map((_, i) => (
            <b class:list={[{ on: i === 0 }]} data-dot />
          ))}
        </div>
        <span class="cap mono"><i class="dot"></i><span data-caption>{captionOf(chapters[0].media)}</span></span>
      </div>

      <ol class="steps">
        {chapters.map((c, i) => (
          <li class:list={['step', { active: i === 0 }]} data-step data-caption={captionOf(c.media)} aria-current={i === 0 ? 'step' : undefined}>
            <span class="k mono">{c.kicker}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            {c.figures.length > 0 && (
              <ul class="nums">
                {c.figures.map((f) => (
                  <li title={f.source}>
                    <b>{f.value}</b>
                    <span>{f.label}</span>
                  </li>
                ))}
              </ul>
            )}
            {c.tags.length > 0 && (
              <div class="tags">
                {c.tags.map((t) => (
                  <Tag state={t.state} label={t.label} />
                ))}
              </div>
            )}
            <p class="sr-only">Image: {info(c.media).alt}</p>
            <figure class="step-img">
              <Media id={c.media} sizes="(max-width: 899px) 100vw, 0px" />
              <figcaption class="mono">{captionOf(c.media)}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </div>
  )
}

<script>
  import '../scripts/story.ts';
</script>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.72fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .stage {
    position: sticky;
    top: calc(var(--nav-h) + 14px);
    height: calc(100svh - var(--nav-h) - 40px);
    max-height: 600px;
    border-radius: 30px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }
  .shot.on {
    opacity: 1;
  }
  .shot :global(picture),
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot :global(img) {
    scale: 1.05;
    transition: scale 2.2s var(--ease);
  }
  .shot.on :global(img) {
    scale: 1;
  }
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(7 9 13 / 0.35), transparent 28%, transparent 70%, rgb(7 9 13 / 0.7));
  }
  .cap {
    position: absolute;
    z-index: 3;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: flex;
    gap: 10px;
    align-items: center;
    width: fit-content;
    max-width: calc(100% - 36px);
    padding: 9px 14px;
    border-radius: 999px;
    background: rgb(16 22 30 / 0.82);
    border: 1px solid rgb(243 238 228 / 0.14);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #f3eee4;
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
  }
  .dots {
    position: absolute;
    z-index: 3;
    right: 18px;
    top: 18px;
    display: flex;
    gap: 6px;
  }
  .dots b {
    position: relative;
    overflow: hidden;
    width: 26px;
    height: 4px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.3);
  }
  .dots b::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }
  .dots b.on::after {
    transform: scaleX(1);
  }
  .steps {
    display: flex;
    flex-direction: column;
  }
  .step {
    min-height: 56svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 24px 0 24px 22px;
    border-left: 2px solid var(--line);
    transition: border-color 0.5s var(--ease);
  }
  .step.active {
    border-left-color: var(--accent);
  }
  .k {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h3 {
    font-size: clamp(28px, 3.1vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 620;
    color: var(--muted);
    transition: color 0.5s var(--ease);
  }
  .step.active h3 {
    color: var(--ink);
  }
  .step p:not(.sr-only) {
    color: var(--muted);
    font-size: clamp(16px, 1.2vw, 18px);
  }
  .nums {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 6px;
  }
  .nums li {
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }
  .nums b {
    display: block;
    font: 600 clamp(17px, 1.6vw, 22px) / 1.1 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .nums span {
    display: block;
    margin-top: 8px;
    font: 500 10px / 1.35 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .step-img {
    display: none;
    margin: 0;
  }
  .step-img :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 20px;
    border: 1px solid var(--line);
  }
  .step-img figcaption {
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  @media (max-width: 899px) {
    .story {
      grid-template-columns: 1fr;
    }
    .stage {
      display: none;
    }
    .step {
      min-height: auto;
      padding: 28px 0 8px;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .step h3 {
      color: var(--ink);
    }
    .step-img {
      display: block;
    }
    .nums {
      grid-template-columns: 1fr;
    }
    .nums li {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }
    .nums span {
      margin: 0;
      text-align: right;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot :global(img) {
      scale: 1;
    }
  }
</style>
