---
import { nav, site } from '../lib/site';

const path = Astro.url.pathname;
const isHome = path === '/';
const isCurrent = (href: string) => !href.includes('#') && href !== '/' && path.startsWith(href);
// On the home page, the matching link lights up while its section is in view.
const spy: Record<string, string> = { '/projects/': 'work', '/#contact': 'contact' };
---

<header class="nav" data-nav>
  <div class="nav-in">
    <a class="brand" href="/" title="Home">
      <span class="logo" aria-hidden="true">L</span>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="links" id="site-nav" aria-label="Primary">
      <span class="ind" data-nav-ind aria-hidden="true"></span>
      {
        nav.map((item) => (
          <a href={item.href} data-nav-link data-spy={isHome ? spy[item.href] : undefined} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-r">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch between dark and light theme" aria-pressed="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle><path d="M12 3v18"></path><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
        </svg>
      </button>
      <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 80;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .nav-in {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 28px);
    padding: 8px 10px 8px 14px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.4s var(--ease),
      border-color 0.4s var(--ease),
      box-shadow 0.4s,
      translate 0.6s var(--ease),
      opacity 0.6s;
  }
  :global(.js) .nav-in {
    translate: 0 -24px;
    opacity: 0;
    animation: nav-in 0.7s var(--ease) 0.15s forwards;
  }
  @keyframes nav-in {
    to {
      translate: 0 0;
      opacity: 1;
    }
  }
  .nav:global(.scrolled) .nav-in {
    background: var(--glass);
    border-color: var(--line);
    box-shadow: 0 10px 40px -14px rgb(0 0 0 / 0.5);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav:global(.scrolled) .nav-in {
      -webkit-backdrop-filter: blur(18px) saturate(1.4);
      backdrop-filter: blur(18px) saturate(1.4);
    }
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font: italic 700 14px var(--font-serif);
  }
  .links {
    position: relative;
    display: flex;
    gap: 2px;
  }
  .links a {
    position: relative;
    z-index: 1;
    padding: 8px 14px;
    font-size: 14px;
    color: var(--muted);
    border-radius: 999px;
    transition: color 0.3s;
  }
  .links a:hover,
  .links a.on,
  .links a[aria-current='page'] {
    color: var(--ink);
  }
  .ind {
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--iw, 0);
    translate: var(--ix, 0) 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    opacity: var(--io, 0);
    transition:
      translate 0.5s var(--ease),
      width 0.5s var(--ease),
      opacity 0.3s;
  }
  .nav-r {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
    transition:
      background 0.3s,
      rotate 0.6s var(--ease);
  }
  .icon-btn:hover {
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    rotate: 25deg;
  }
  .menu-btn {
    display: none;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    font-size: 14px;
    cursor: pointer;
  }
  .progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    transform-origin: left;
    transform: scaleX(var(--p, 0));
    background: linear-gradient(90deg, var(--accent), var(--ok));
    pointer-events: none;
  }
  /* Mobile dropdown only when JavaScript can open it; without JS the links stay visible inline. */
  @media (max-width: 820px) {
    :global(.js) .links {
      position: absolute;
      top: calc(100% + 8px);
      left: 50%;
      translate: -50% -8px;
      flex-direction: column;
      min-width: 220px;
      padding: 8px;
      border-radius: 22px;
      background: var(--surface);
      border: 1px solid var(--line);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s,
        translate 0.4s var(--ease),
        visibility 0.3s;
    }
    .links a {
      padding: 12px 16px;
    }
    .nav:global(.open) .links {
      opacity: 1;
      visibility: visible;
      translate: -50% 0;
    }
    .ind {
      display: none;
    }
    :global(.js) .menu-btn {
      display: block;
    }
    :global(.js) .links a {
      padding: 12px 16px;
    }
    :global(.js) .ind {
      display: none;
    }
  }
  @media (max-width: 400px) {
    /* Visually hidden but still the link's accessible name (display:none would leave the link unnamed). */
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .nav-in {
      translate: none;
      opacity: 1;
      animation: none;
    }
  }
</style>
