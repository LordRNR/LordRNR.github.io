---
import SectionHead from '../components/SectionHead.astro';
import { copy } from '../data/copy';
import { getProjects, publicEvidence } from '../lib/projects';

// The "Verified" column is computed from the data, not typed by hand.
const projects = await getProjects();
const all = projects.flatMap(publicEvidence);
const n = (s: string) => all.filter((e) => e.state === s).length;
const summary = `${all.length} claims across ${projects.length} projects: ${n('tested')} tested, ${n('implemented')} implemented, ${n('pending')} pending.`;
---

<section class="sec" id="process" aria-labelledby="process-h">
  <div class="wrap">
    <SectionHead idx="05 — Process" id="process-h">
      Human decisions, <em>AI assistance</em>, and what gets verified.
      <Fragment slot="lede">{copy.process.lede}</Fragment>
    </SectionHead>
    <ol class="cols" data-stagger>
      {
        copy.process.columns.map((c, i) => (
          <li class={`col ${c.key}`}>
            <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            {c.key === 'verified' && <p class="calc mono">{summary}</p>}
          </li>
        ))
      }
    </ol>
    <p class="more"><a href="/about/#process">How I work, in detail <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .sec {
    padding-block: var(--section-y);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 20px 24px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .col.human {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .col.assisted {
    border-color: color-mix(in srgb, var(--ink) 28%, transparent);
  }
  .num {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--faint);
  }
  h3 {
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  p {
    color: var(--muted);
    font-size: 15px;
  }
  .calc {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    line-height: 1.55;
    letter-spacing: 0.03em;
    color: var(--ink);
  }
  .more {
    margin-top: 24px;
  }
  .more a {
    display: inline-block;
    padding: 10px 0;
    font-weight: 500;
    border-bottom: 1px solid var(--line-strong);
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .more a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 1100px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
