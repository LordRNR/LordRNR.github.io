---
import SectionHead from '../components/SectionHead.astro';
import Tag from '../components/Tag.astro';
import Ledger from '../components/Ledger.astro';
import { copy } from '../data/copy';
import { getFeatured, publicEvidence } from '../lib/projects';

// Compact ledger: verified, highlighted claims from the featured projects. Full ledgers live in each case study.
const featured = await getFeatured();
const rows = featured.flatMap((p) =>
  publicEvidence(p)
    .filter((e) => e.highlight)
    .map((e) => ({ project: p.data.name, claim: e.claim, detail: e.detail, state: e.state })),
);
---

<section class="sec" id="method" aria-labelledby="method-h">
  <div class="wrap">
    <SectionHead idx="04 — Method" id="method-h">
      Every claim has <em>one of three</em> words.
      <Fragment slot="lede">{copy.method.lede}</Fragment>
    </SectionHead>

    <ul class="defs" data-stagger>
      {
        copy.method.definitions.map((d) => (
          <li class={`def ${d.state}`}>
            <Tag state={d.state as 'implemented' | 'tested' | 'pending'} />
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </li>
        ))
      }
    </ul>

    <div data-reveal>
      <Ledger rows={rows} title="The ledger · highlights" />
    </div>
    <p class="note">The full ledger of each project is in its case study.</p>
  </div>
</section>

<style>
  .sec {
    padding-block: var(--section-y);
  }
  .defs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: clamp(32px, 5vh, 56px);
  }
  .def {
    --c: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(22px, 2.4vw, 34px);
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      transform 0.4s var(--ease),
      border-color 0.4s;
  }
  .def:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--c) 55%, transparent);
  }
  .def.tested {
    --c: var(--ok);
  }
  .def.pending {
    --c: var(--signal);
  }
  .def :global(.tag) {
    align-self: flex-start;
  }
  h3 {
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 620;
  }
  p {
    color: var(--muted);
  }
  .note {
    margin-top: 14px;
    font-size: 14px;
    color: var(--faint);
  }
  @media (max-width: 900px) {
    .defs {
      grid-template-columns: 1fr;
    }
  }
</style>
