---
import Tag from './Tag.astro';
import { formatPeriod, statusMeta, type Project } from '../lib/projects';

/** Title block shared by the home features, the cards and the case studies. */
interface Props {
  project: Project;
  as?: 'h1' | 'h2' | 'h3';
  linkTitle?: boolean;
  titleId?: string;
}
const { project, as: Heading = 'h3', linkTitle = false, titleId } = Astro.props;
const d = project.data;
const href = d.caseStudy.enabled ? `/projects/${project.id}/` : null;
---

<div class="head">
  <div>
    <Heading class="title" id={titleId}>
      {linkTitle && href ? <a href={href}>{d.name}</a> : d.name}
    </Heading>
    <p class="tagline">{d.tagline}</p>
  </div>
  <div class="meta">
    <Tag state={d.status} label={d.statusNote ? `${statusMeta[d.status].label} · ${d.statusNote}` : undefined} />
    {d.tech.slice(0, 5).map((t) => <span class="pill mono">{t}</span>)}
    <span class="pill mono">{formatPeriod(project)}</span>
  </div>
</div>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    align-items: end;
    justify-content: space-between;
    margin-bottom: clamp(24px, 4vh, 44px);
  }
  .title {
    font-weight: 650;
    font-size: clamp(34px, 5vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .title a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .title a:hover {
    background-size: 100% 2px;
  }
  .tagline {
    margin-top: 16px;
    max-width: 34em;
    font-size: clamp(17px, 1.4vw, 21px);
    line-height: 1.45;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .pill {
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>
