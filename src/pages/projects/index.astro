---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categoryLabel, getProjects } from '../../lib/projects';

const projects = await getProjects();
const categories = [...new Set(projects.map((p) => p.data.category))];
const techs = [...new Set(projects.flatMap((p) => p.data.tech))].sort((a, b) => a.localeCompare(b));
const VISIBLE_TECH = 8; // the rest folds into a <details> so the filter bar stays compact as projects grow
---

<Base title="Projects" description="All projects: games, research and software, each with its status and the evidence behind it.">
  <section class="wrap page">
    <header class="head">
      <p class="eyebrow mono">Projects</p>
      <h1>Everything I've built, <em>with its status</em>.</h1>
      <p class="lede">
        Each project shows what is implemented, what has been tested and what is still pending. Planned projects, when they appear, are labelled as planned.
      </p>
    </header>

    {
      projects.length > 1 && (
        <div class="filters" data-filters>
          <div class="group" data-group="category" role="group" aria-label="Filter by category">
            <span class="glabel mono">Category</span>
            <button type="button" data-value="all" aria-pressed="true">All</button>
            {categories.map((c) => <button type="button" data-value={c} aria-pressed="false">{categoryLabel[c]}</button>)}
          </div>
          <div class="group" data-group="tech" role="group" aria-label="Filter by technology">
            <span class="glabel mono">Technology</span>
            <button type="button" data-value="all" aria-pressed="true">All</button>
            {techs.slice(0, VISIBLE_TECH).map((t) => <button type="button" data-value={t} aria-pressed="false">{t}</button>)}
            {techs.length > VISIBLE_TECH && (
              <details class="more">
                <summary>More technologies ({techs.length - VISIBLE_TECH})</summary>
                <div class="morelist">
                  {techs.slice(VISIBLE_TECH).map((t) => <button type="button" data-value={t} aria-pressed="false">{t}</button>)}
                </div>
              </details>
            )}
          </div>
        </div>
      )
    }
    <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>

    <div class="grid" data-stagger>
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<script>
  import '../../scripts/filters.ts';
</script>

<style>
  .page {
    padding: calc(var(--nav-h) + clamp(32px, 7vh, 80px)) 0 var(--section-y);
  }
  .head {
    margin-bottom: clamp(28px, 5vh, 56px);
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin-top: 16px;
    max-width: 14em;
    font-weight: 650;
    font-size: clamp(38px, 6.4vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  h1 em {
    font: italic 500 1.02em var(--font-serif);
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .lede {
    margin-top: 20px;
    max-width: 38em;
    color: var(--muted);
    font-size: clamp(17px, 1.35vw, 20px);
  }
  .filters {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(24px, 4vh, 40px);
    padding: 16px 0;
    border-block: 1px solid var(--line);
  }
  .group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .glabel {
    min-width: 92px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .group button {
    min-height: 40px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .group button:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .more {
    display: contents;
  }
  .more summary {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px dashed var(--line-strong);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .morelist {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex-basis: 100%;
    margin-top: 8px;
  }
  .group button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 18px;
  }
</style>
