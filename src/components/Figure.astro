---
import Media from './Media.astro';
import { getMedia, kindLabel } from '../lib/media';

interface Props {
  id: string;
  sizes?: string;
  priority?: boolean;
  ratio?: string; // CSS aspect-ratio, e.g. "16 / 10"
}
const { id, sizes, priority = false, ratio = '16 / 10' } = Astro.props;
const { entry } = getMedia(id);
const showDevBadge = import.meta.env.DEV && entry.verification !== 'verified';
---

<figure class="fig">
  <div class="frame" style={`aspect-ratio:${ratio}`}>
    <Media id={id} sizes={sizes} priority={priority} />
  </div>
  <figcaption>
    <span class="kind mono">{kindLabel[entry.kind]}</span>
    <span>{entry.caption}</span>
    {entry.credit && <span class="credit"> · {entry.credit}</span>}
    {showDevBadge && <span class="dev mono">dev: {entry.verification}</span>}
  </figcaption>
</figure>

<style>
  .fig {
    margin: 0;
  }
  .frame {
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .frame :global(img),
  .frame :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
  }
  .kind {
    display: inline-block;
    margin-right: 8px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .dev {
    margin-left: 8px;
    padding: 2px 6px;
    border: 1px dashed var(--signal);
    color: var(--signal);
    font-size: 10px;
    border-radius: 4px;
  }
</style>
